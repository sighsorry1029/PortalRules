        <Compile Include="PublicPortalTaggedConnections.cs"/>
        <Compile Include="PublicPortalFavoritePanel.cs"/>
        <Compile Include="PublicPortalTravelCost.cs"/>
        <Compile Include="PublicPortalTeleportService.cs"/>
        <Compile Include="PublicPortalTeleportService.Transactions.cs"/>
        <Compile Include="Properties\AssemblyInfo.cs"/>
    </ItemGroup>
    <ItemGroup>
        <Content Include=".gitignore"/>
        <Content Include="environment.props" Condition="Exists('environment.props')"/>
        <Content Include="ILRepack.targets"/>
        <Content Include="Libs\ServerSync.dll">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Include="LICENSE"/>
        <Content Include="README.md"/>
        <EmbeddedResource Include="THIRD-PARTY-NOTICES.txt">
            <LogicalName>PortalRules.THIRD-PARTY-NOTICES.txt</LogicalName>
        </EmbeddedResource>
        <Content Include="Thunderstore\CHANGELOG.md"/>
        <Content Include="Thunderstore\icon.png"/>
        <Content Include="Thunderstore\manifest.json"/>
        <EmbeddedResource Include="translations\English.yml">
            <LogicalName>PortalRules.translations.English.yml</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="translations\Korean.yml">
            <LogicalName>PortalRules.translations.Korean.yml</LogicalName>
        </EmbeddedResource>
        <Content Include="UpdateManifest.ps1"/>
    </ItemGroup>
    <ItemGroup>
        <None Include="App.config"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
    <Target Name="GetAssemblyVersion" AfterTargets="ILRepacker">
        <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
            <Output TaskParameter="Assemblies" ItemName="Targets"/>
        </GetAssemblyIdentity>
        <ItemGroup>
            <AssemblyVersions Include="@(Targets->'%(Version)')"/>
        </ItemGroup>
        <Error Text="Failed to get Assembly Version." Condition="'%(AssemblyVersions.Identity)' == ''"/>
        <PropertyGroup>
            <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
            <Major>$(AssemblyVersion.Split('.')[0])</Major>
            <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
            <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
            <PackageName>$(AssemblyName)_v$(Major).$(Minor).$(Patch)</PackageName>
            <PackageVersion>$(Major).$(Minor).$(Patch)</PackageVersion>
            <ThunderstorePackageDir>$(IntermediateOutputPath)PortalRulesPackage\Thunderstore\$(PackageName)</ThunderstorePackageDir>
            <NexusPackageDir>$(IntermediateOutputPath)PortalRulesPackage\Nexus\$(PackageName)</NexusPackageDir>
        </PropertyGroup>
    </Target>
    <Target Name="CopyOutputDLL" AfterTargets="GetAssemblyVersion" Condition="'$(DeployToGame)' == 'true'">
        <Error Text="DLL not found in target directory." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Error Text="CopyOutputDLLPath must point to an existing directory when DeployToGame is true." Condition="'$(CopyOutputDLLPath)' == '' Or !Exists('$(CopyOutputDLLPath)')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath)" OverwriteReadOnlyFiles="true"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath2)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath2)')"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(CopyOutputDLLPath3)" OverwriteReadOnlyFiles="true" Condition="Exists('$(CopyOutputDLLPath3)')"/>
    </Target>
    <Target Name="UpdateManifestVersion" AfterTargets="GetAssemblyVersion" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <Error Text="manifest.json not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)Thunderstore\manifest.json')"/>
        <ItemGroup>
            <ManifestFile Include="$(ProjectDir)Thunderstore\manifest.json"/>
        </ItemGroup>
        <Message Text="ManifestFile is @(ManifestFile)"/>
        <Message Text="Updating version number in Thunderstore\manifest.json" Condition="Exists(@(ManifestFile))"/>
        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { &amp; '$(ProjectDir)UpdateManifest.ps1' -manifestFile '@(ManifestFile)' -versionString '$(PackageVersion)' }&quot;" Condition="'$(OS)' == 'Windows_NT'"/>
        <Exec Command="pwsh -NoProfile -File &quot;$(ProjectDir)UpdateManifest.ps1&quot; -manifestFile &quot;@(ManifestFile)&quot; -versionString &quot;$(PackageVersion)&quot;" Condition="'$(OS)' != 'Windows_NT'"/>
    </Target>
    <Target Name="MakeThunderstorePackage" AfterTargets="UpdateManifestVersion" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <Error Text="PortalRules.dll not found in the Release output." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <Error Text="root README.md not found." Condition="!Exists('$(ProjectDir)README.md')"/>
        <Error Text="CHANGELOG.md not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)Thunderstore\CHANGELOG.md')"/>
        <Error Text="manifest.json not found in Thunderstore directory." Condition="!Exists('$(ProjectDir)\Thunderstore\manifest.json')"/>
        <Error Text="icon.png not found in Thunderstore directory. Please note that Thunderstore requires this image to be 256x256 in dimension" Condition="!Exists('$(ProjectDir)\Thunderstore\icon.png')"/>
        <Error Text="translations\English.yml not found." Condition="!Exists('$(ProjectDir)translations\English.yml')"/>
        <ItemGroup>
            <ThunderstorePackageFiles Include="$(TargetDir)$(AssemblyName).dll"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)README.md"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\CHANGELOG.md"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\manifest.json"/>
            <ThunderstorePackageFiles Include="$(ProjectDir)Thunderstore\icon.png"/>
        </ItemGroup>
        <RemoveDir Directories="$(ThunderstorePackageDir)" Condition="Exists('$(ThunderstorePackageDir)')"/>
        <MakeDir Directories="$(ThunderstorePackageDir)"/>
        <Copy SourceFiles="@(ThunderstorePackageFiles)" DestinationFolder="$(ThunderstorePackageDir)"/>
        <Copy SourceFiles="$(ProjectDir)translations\English.yml" DestinationFiles="$(ThunderstorePackageDir)\PortalRules.English.yml"/>
        <ZipDirectory SourceDirectory="$(ThunderstorePackageDir)" DestinationFile="$(ProjectDir)Thunderstore\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(ThunderstorePackageDir)"/>
    </Target>
    <Target Name="MakeNexusPackage" AfterTargets="MakeThunderstorePackage" Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <Error Text="PortalRules.dll not found in the Release output." Condition="!Exists('$(TargetDir)$(AssemblyName).dll')"/>
        <MakeDir Directories="$(ProjectDir)\Nexus"/>
        <RemoveDir Directories="$(NexusPackageDir)" Condition="Exists('$(NexusPackageDir)')"/>
        <MakeDir Directories="$(NexusPackageDir)"/>
        <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(NexusPackageDir)"/>
        <ZipDirectory SourceDirectory="$(NexusPackageDir)" DestinationFile="$(ProjectDir)Nexus\$(PackageName).zip" Overwrite="true"/>
        <RemoveDir Directories="$(NexusPackageDir)"/>
    </Target>

</Project>
